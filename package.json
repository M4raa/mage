{
  "name": "mage",
  "version": "0.1.1",
  "description": "Wrapper multiagentico y multi-proveedor sobre agentes de codigo tipo Claude Code",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "M4raa",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "clean": "node scripts/clean.mjs",
    "rebuild": "pnpm run clean && pnpm run build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cross-env MAGE_E2E=1 vitest run src/main/engine/agentSession.integration.test.ts",
    "spike": "node spike/engine-spike.mjs",
    "brand": "node scripts/trace-brand.mjs",
    "icons": "node scripts/rasterize-icons.mjs",
    "lint": "eslint .",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run notices:check",
    "verify:gui": "node scripts/verify-gui.mjs",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "shots": "node scripts/readme-shots.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "electron-updater": "^6.8.9",
    "motion": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-window": "^2.2.7",
    "shiki": "^4.4.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/get": "^3.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright-core": "^1.61.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
